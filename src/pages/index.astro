---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="RoboMatrix - 机器人产业深度研究与职业导航" lang="cn">
  <section class="py-20 text-center">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">RoboMatrix</h1>
    <p class="text-neutral-400 text-lg mb-8">机器人产业深度研究与职业导航平台</p>
    <div class="flex justify-center gap-4">
      <a href="/cn/" class="px-6 py-3 bg-primary-700 text-white rounded-lg text-sm font-medium hover:bg-primary-600 no-underline">
        中文站
      </a>
      <a href="/en/" class="px-6 py-3 border border-neutral-700 text-neutral-300 rounded-lg text-sm font-medium hover:bg-neutral-900 no-underline">
        English
      </a>
    </div>
  </section>
</BaseLayout>
