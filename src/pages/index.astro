---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="RoboAudit - 机器人行业尽调与职业导航" lang="cn">
  <section class="py-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">机器人行业深度研究平台</h1>
    <p class="text-neutral-400 text-lg max-w-2xl mb-8">
      以审计级严谨度，拆解机器人产业链。为从业者提供尽调报告、BOM 成本分析与职业发展导航。
    </p>
    <div class="flex gap-4">
      <a href="/cn/research/" class="px-4 py-2 bg-primary-700 text-white rounded text-sm hover:bg-primary-600">
        尽调研究
      </a>
      <a href="/cn/career/" class="px-4 py-2 border border-neutral-700 text-neutral-300 rounded text-sm hover:bg-neutral-800">
        职业导航
      </a>
    </div>
  </section>
</BaseLayout>
