---
import '../../styles/global.css';

const companies = [
  { name: 'Nuro', count: 95, color: 'blue' },
  { name: 'Zipline', count: 131, color: 'cyan' },
  { name: 'Agility Robotics', count: 54, color: 'lime' },
];

const jobs = [
  {
    company: 'Nuro',
    title: 'Software Engineer, Offboard Infrastructure',
    location: 'Mountain View, California (HQ)',
    department: 'Offboard Infrastructure',
    kind: '软件',
  },
  {
    company: 'Nuro',
    title: 'Mechanical Engineer, Autonomous Vehicle',
    location: 'Mountain View, California (HQ)',
    department: 'AV Hardware Engineering',
    kind: '机械',
  },
  {
    company: 'Zipline',
    title: 'Forward Deployed AI Engineer, Operations',
    location: 'South San Francisco, California, USA',
    department: 'Engineering',
    kind: 'AI',
  },
  {
    company: 'Zipline',
    title: 'Hardware Test Engineer, Droid',
    location: 'South San Francisco, California, USA',
    department: 'Hardware',
    kind: '硬件',
  },
  {
    company: 'Agility Robotics',
    title: 'Robotics Software Engineer II',
    location: 'Hybrid- Pittsburgh, PA or Salem, OR',
    department: 'Software Engineering',
    kind: '机器人',
  },
  {
    company: 'Agility Robotics',
    title: 'Senior Systems Engineer',
    location: 'Hybrid- Fremont, CA',
    department: 'Hardware',
    kind: '系统',
  },
];

const workflow = [
  { number: '01', title: '企业官方招聘网站', note: '锁定可信的一手来源', status: '已完成', phase: 'done' },
  { number: '02', title: '获取真实岗位与 JD', note: '建立可持续更新的岗位基线', status: '已完成', phase: 'done' },
  { number: '03', title: '识别新增、变化和下架', note: '持续观察企业需求如何变化', status: '正在运行', phase: 'running' },
  { number: '04', title: '分析真实技能需求', note: '从 JD 提取技能与经验要求', status: '下一阶段', phase: 'next' },
  { number: '05', title: '连接作品、学习与行动', note: '把岗位要求变成可执行路径', status: '下一阶段', phase: 'next' },
];

const collaboration = [
  {
    index: '01',
    label: 'ChatGPT 项目',
    lead: '想清楚要做什么',
    items: ['澄清需求', '设计产品方向', '审核开发方案', '管理长期上下文'],
    tone: 'blue',
  },
  {
    index: '02',
    label: 'Codex',
    lead: '把想法做成真实作品',
    items: ['进入代码仓库', '开发功能', '运行测试', '发现问题并修改', '完成交付'],
    tone: 'cyan',
  },
  {
    index: '03',
    label: '本地文件与 Git',
    lead: '让作品可以持续生长',
    items: ['保存项目状态', '记录关键决策', '沉淀可复用资产', '形成持续迭代的作品'],
    tone: 'lime',
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="机器人职业情报与能力发展系统线下课程展示：从企业真实招聘岗位，反向连接技能、作品与职业行动。"
    />
    <title>机器人职业情报与能力发展系统</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar content-width">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>ROBOT CAREER INTELLIGENCE</span>
        </div>
        <div class="snapshot">真实岗位快照 · 2026.07.18</div>
      </header>

      <main>
        <section class="hero section content-width" aria-labelledby="page-title">
          <div class="hero-copy">
            <p class="eyebrow"><span>LIVE PROJECT</span> 从真实问题出发的 AI 协作作品</p>
            <h1 id="page-title">机器人职业情报<br />与能力发展系统</h1>
            <p class="subtitle">从企业真实招聘岗位，反向连接技能、作品与职业行动</p>
            <div class="hero-proof">
              <span class="proof-dot" aria-hidden="true"></span>
              今天，第一份真实岗位基线已经建立
            </div>
          </div>

          <div class="hero-dashboard" aria-label="今日成果概览">
            <div class="radar" aria-hidden="true">
              <span class="radar-ring ring-one"></span>
              <span class="radar-ring ring-two"></span>
              <span class="radar-ring ring-three"></span>
              <span class="radar-line horizontal"></span>
              <span class="radar-line vertical"></span>
              <span class="radar-pulse pulse-one"></span>
              <span class="radar-pulse pulse-two"></span>
              <span class="radar-pulse pulse-three"></span>
              <span class="radar-core">280</span>
            </div>
            <div class="dashboard-meta">
              <div><strong>3</strong><span>家机器人公司</span></div>
              <div><strong>5</strong><span>种岗位变化状态</span></div>
            </div>
          </div>
        </section>

        <section class="section content-width why-section" aria-labelledby="why-title">
          <div class="section-heading">
            <p class="section-index">01 · WHY</p>
            <h2 id="why-title">为什么做这个系统？</h2>
            <p>不是再做一份泛泛的职业指南，而是先看企业此刻真正需要什么。</p>
          </div>
          <div class="why-grid">
            <article>
              <span class="card-number">01</span>
              <h3>行业变化太快</h3>
              <p>机器人、AI 与自动驾驶不断出现新方向，旧经验很快失效。</p>
            </article>
            <article>
              <span class="card-number">02</span>
              <h3>真实需求不透明</h3>
              <p>青年人很难知道，企业现在究竟在招什么人、重视什么能力。</p>
            </article>
            <article>
              <span class="card-number">03</span>
              <h3>学习与岗位脱节</h3>
              <p>课程、作品和真实岗位之间缺少一条可以持续验证的连接。</p>
            </article>
            <article class="why-answer">
              <span class="card-number">04</span>
              <h3>让建议更可靠</h3>
              <p>持续跟踪企业官方招聘信息，再把岗位变化转化为职业行动。</p>
            </article>
          </div>
        </section>

        <section class="section results-section" aria-labelledby="results-title">
          <div class="content-width">
            <div class="section-heading split-heading">
              <div>
                <p class="section-index">02 · TODAY</p>
                <h2 id="results-title">今天已经完成的成果</h2>
              </div>
              <p>从“能不能做”，走到“真实数据已经开始持续运行”。</p>
            </div>

            <div class="results-lead">
              <div class="big-number">
                <strong>280</strong>
                <span>个官方在招岗位</span>
              </div>
              <div class="result-summary">
                <div><strong>3</strong><span>家公司</span></div>
                <div><strong>3/3</strong><span>官方来源已验证</span></div>
                <div><strong>1</strong><span>份真实岗位基线</span></div>
              </div>
            </div>

            <div class="company-grid">
              {companies.map((company) => (
                <article class={`company-card ${company.color}`}>
                  <div class="company-name">{company.name}</div>
                  <div class="company-count"><strong>{company.count}</strong><span>个岗位</span></div>
                  <div class="company-bar" aria-hidden="true"><span style={`width: ${(company.count / 131) * 100}%`}></span></div>
                  <p>官方招聘来源已验证</p>
                </article>
              ))}
            </div>

            <div class="capability-row">
              <p>系统已经能够识别</p>
              <div class="capability-tags" aria-label="岗位变化识别能力">
                <span>新增</span><span>更新</span><span>缺失</span><span>关闭</span><span>重新开放</span>
              </div>
              <div class="observation"><span aria-hidden="true"></span>正在进入 7—14 天连续观察</div>
            </div>

            <blockquote>“这些不是演示数据，而是来自企业官方招聘系统的真实岗位。”</blockquote>
          </div>
        </section>

        <section class="section workflow-section content-width" aria-labelledby="workflow-title">
          <div class="section-heading">
            <p class="section-index">03 · HOW IT WORKS</p>
            <h2 id="workflow-title">系统怎样把岗位变成行动？</h2>
            <p>从可信的一手信息出发，一步步走向个性化的学习与作品建议。</p>
          </div>
          <div class="workflow">
            {workflow.map((step, index) => (
              <>
                <article class={`workflow-step ${step.phase}`}>
                  <div class="step-top">
                    <span class="step-number">{step.number}</span>
                    <span class="step-status">{step.status}</span>
                  </div>
                  <h3>{step.title}</h3>
                  <p>{step.note}</p>
                </article>
                {index < workflow.length - 1 && <div class="workflow-arrow" aria-hidden="true">→</div>}
              </>
            ))}
          </div>
          <div class="workflow-legend">
            <span class="legend-line active"></span><span>已经完成或正在运行</span>
            <span class="legend-line future"></span><span>下一阶段</span>
          </div>
        </section>

        <section class="section jobs-section" aria-labelledby="jobs-title">
          <div class="content-width">
            <div class="section-heading split-heading">
              <div>
                <p class="section-index">04 · REAL JOBS</p>
                <h2 id="jobs-title">280 个岗位里，有哪些真实机会？</h2>
              </div>
              <p>以下 6 个岗位直接选自今天的真实基线快照。</p>
            </div>
            <div class="jobs-grid">
              {jobs.map((job) => (
                <article class="job-card">
                  <div class="job-head">
                    <span class="job-company">{job.company}</span>
                    <span class="job-kind">{job.kind}</span>
                  </div>
                  <h3>{job.title}</h3>
                  <dl>
                    <div>
                      <dt>地点</dt>
                      <dd>{job.location}</dd>
                    </div>
                    <div>
                      <dt>部门</dt>
                      <dd>{job.department}</dd>
                    </div>
                  </dl>
                </article>
              ))}
            </div>
            <p class="snapshot-note">静态快照 · 岗位名称、地点与部门均以 2026 年 7 月 18 日的企业官方招聘信息为准</p>
          </div>
        </section>

        <section class="section collaboration-section content-width" aria-labelledby="collaboration-title">
          <div class="section-heading">
            <p class="section-index">05 · AI COLLABORATION</p>
            <h2 id="collaboration-title">ChatGPT 和 Codex，如何协作完成真实作品？</h2>
            <p>AI 不只负责“回答”，而是在清晰分工和持续记录中参与完整项目。</p>
          </div>
          <div class="collaboration-grid">
            {collaboration.map((module) => (
              <article class={`collaboration-card ${module.tone}`}>
                <div class="collaboration-index">{module.index}</div>
                <p class="collaboration-label">{module.label}</p>
                <h3>{module.lead}</h3>
                <ul>
                  {module.items.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))}
          </div>
          <div class="collaboration-equation" aria-label="协作关系">
            <span>方向与判断</span><b>+</b><span>开发与验证</span><b>+</b><span>状态与资产</span><b>=</b><strong>可持续迭代的真实作品</strong>
          </div>
        </section>

        <section class="section iteration-section" aria-labelledby="iteration-title">
          <div class="content-width iteration-wrap">
            <div class="section-heading">
              <p class="section-index">06 · ITERATION</p>
              <h2 id="iteration-title">真实运行，才会暴露真实问题</h2>
            </div>
            <div class="cases">
              <article>
                <div class="case-label">案例一 · 正文清洗</div>
                <h3>页面“看起来能读”，数据里却残留 HTML 标签</h3>
                <p>真实运行发现后，Codex 修改清洗逻辑，并补充测试，确保岗位正文真正可用。</p>
                <div class="case-path"><span>发现问题</span><i>→</i><span>修改逻辑</span><i>→</i><span>补充测试</span></div>
              </article>
              <article>
                <div class="case-label">案例二 · 登录误报</div>
                <h3>正常岗位正文里的 “sign in / log in” 被当成拦截</h3>
                <p>Codex 缩小检测范围，修复 Agility Robotics 的误报，并完成回归验证。</p>
                <div class="case-path"><span>真实反馈</span><i>→</i><span>定位原因</span><i>→</i><span>回归验证</span></div>
              </article>
            </div>
            <blockquote>“真实作品不是一次生成，而是在真实反馈中不断修正。”</blockquote>
          </div>
        </section>

        <section class="section next-section content-width" aria-labelledby="next-title">
          <div class="section-heading centered-heading">
            <p class="section-index">07 · WHAT'S NEXT</p>
            <h2 id="next-title">下一步，让岗位数据真正帮助一个人行动</h2>
          </div>
          <div class="next-steps">
            <article>
              <span>01</span>
              <h3>观察变化</h3>
              <p>连续观察 7—14 天，确认真实岗位的新增、变化与下架。</p>
            </article>
            <div class="next-link" aria-hidden="true"></div>
            <article>
              <span>02</span>
              <h3>提取能力</h3>
              <p>从岗位 JD 中提取技能、工具、经验和问题场景。</p>
            </article>
            <div class="next-link" aria-hidden="true"></div>
            <article>
              <span>03</span>
              <h3>形成行动</h3>
              <p>建立岗位—技能—作品—28 天行动计划的映射。</p>
            </article>
          </div>
        </section>

        <section class="closing content-width" aria-label="结束语">
          <p>从一个真实问题开始，<br />让 AI 帮助我们持续观察、学习与创造。</p>
          <h2>Keep curious, keep learning,<br />and keep <span>Building.</span></h2>
          <div class="closing-line" aria-hidden="true"></div>
        </section>
      </main>

      <footer class="content-width">
        <span>机器人职业情报与能力发展系统</span>
        <span>COURSE DEMO · 2026</span>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #060b14;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background:
      radial-gradient(circle at 82% 6%, rgba(48, 116, 255, 0.16), transparent 30rem),
      #060b14;
    color: #eaf0f8;
    font-family: Inter, "Noto Sans SC", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
    line-height: 1.65;
  }

  .page-shell {
    overflow: hidden;
  }

  .content-width {
    width: min(1440px, calc(100% - 112px));
    margin-inline: auto;
  }

  .topbar {
    height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(148, 169, 201, 0.18);
    color: #91a1b9;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .brand-mark {
    width: 17px;
    height: 17px;
    border: 2px solid #56d9ff;
    border-radius: 4px;
    box-shadow: inset 6px -6px 0 rgba(104, 241, 181, 0.9);
    transform: rotate(45deg);
  }

  .snapshot {
    color: #6c7a91;
  }

  .section {
    padding-block: 120px;
  }

  .hero {
    min-height: 790px;
    display: grid;
    grid-template-columns: minmax(0, 1.24fr) minmax(420px, 0.76fr);
    align-items: center;
    gap: 72px;
    position: relative;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 4% -10vw 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(148, 169, 201, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 169, 201, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 70%, transparent);
  }

  .eyebrow,
  .section-index {
    margin: 0 0 24px;
    color: #76dfff;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .eyebrow span {
    margin-right: 12px;
    padding: 7px 10px;
    border: 1px solid rgba(86, 217, 255, 0.4);
    border-radius: 99px;
    background: rgba(86, 217, 255, 0.08);
    font-size: 11px;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 880px;
    margin-bottom: 30px;
    color: #f7faff;
    font-size: clamp(54px, 5.25vw, 88px);
    line-height: 1.08;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .subtitle {
    max-width: 720px;
    margin-bottom: 42px;
    color: #abb9cd;
    font-size: clamp(21px, 1.7vw, 28px);
    line-height: 1.6;
  }

  .hero-proof {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    padding: 12px 17px;
    border: 1px solid rgba(104, 241, 181, 0.3);
    border-radius: 10px;
    background: rgba(104, 241, 181, 0.07);
    color: #c1f9dc;
    font-size: 15px;
    font-weight: 700;
  }

  .proof-dot,
  .observation > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #68f1b5;
    box-shadow: 0 0 0 5px rgba(104, 241, 181, 0.12);
  }

  .hero-dashboard {
    min-height: 500px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(122, 157, 205, 0.2);
    border-radius: 36px;
    background: linear-gradient(145deg, rgba(18, 33, 57, 0.88), rgba(8, 15, 27, 0.8));
    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.28);
  }

  .radar {
    width: 330px;
    aspect-ratio: 1;
    position: relative;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(57, 123, 255, 0.12), transparent 66%);
  }

  .radar-ring,
  .radar-line,
  .radar-pulse,
  .radar-core {
    position: absolute;
  }

  .radar-ring {
    inset: 0;
    margin: auto;
    border: 1px solid rgba(95, 180, 255, 0.23);
    border-radius: 50%;
  }

  .ring-one { width: 100%; height: 100%; }
  .ring-two { width: 68%; height: 68%; }
  .ring-three { width: 36%; height: 36%; }
  .radar-line.horizontal { top: 50%; width: 100%; height: 1px; background: rgba(95, 180, 255, 0.14); }
  .radar-line.vertical { left: 50%; width: 1px; height: 100%; background: rgba(95, 180, 255, 0.14); }

  .radar-pulse {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #68f1b5;
    box-shadow: 0 0 20px rgba(104, 241, 181, 0.8);
  }

  .pulse-one { top: 23%; left: 61%; }
  .pulse-two { top: 58%; left: 22%; background: #56d9ff; box-shadow: 0 0 20px rgba(86, 217, 255, 0.8); }
  .pulse-three { top: 69%; left: 72%; background: #7c9cff; box-shadow: 0 0 20px rgba(124, 156, 255, 0.8); }

  .radar-core {
    inset: 0;
    display: grid;
    place-items: center;
    color: #f7faff;
    font-size: 64px;
    font-weight: 800;
    letter-spacing: -0.06em;
  }

  .dashboard-meta {
    position: absolute;
    right: 24px;
    bottom: 22px;
    left: 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .dashboard-meta div {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 13px 15px;
    border-radius: 12px;
    background: rgba(4, 10, 20, 0.62);
  }

  .dashboard-meta strong {
    color: #f7faff;
    font-size: 24px;
  }

  .dashboard-meta span {
    color: #8493aa;
    font-size: 12px;
  }

  .section-heading {
    max-width: 930px;
    margin-bottom: 58px;
  }

  .section-heading h2 {
    margin-bottom: 18px;
    color: #f7faff;
    font-size: clamp(38px, 3.2vw, 56px);
    line-height: 1.18;
    letter-spacing: -0.04em;
  }

  .section-heading > p:last-child,
  .split-heading > p {
    margin-bottom: 0;
    color: #93a2b7;
    font-size: 20px;
  }

  .split-heading {
    max-width: none;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 60px;
  }

  .split-heading > p {
    max-width: 430px;
    padding-bottom: 8px;
    text-align: right;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .why-grid article {
    min-height: 280px;
    padding: 30px 28px;
