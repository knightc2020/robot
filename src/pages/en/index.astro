---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="RoboAudit - Robotics Due Diligence & Career Intelligence" lang="en">
  <section class="py-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">Robotics Industry Intelligence Platform</h1>
    <p class="text-neutral-400 text-lg max-w-2xl mb-8">
      Audit-grade rigor applied to robotics supply chains. Deep-dive due diligence reports, BOM teardowns, and career navigation for engineers.
    </p>
    <div class="flex gap-4">
      <a href="/en/research/" class="px-4 py-2 bg-primary-700 text-white rounded text-sm hover:bg-primary-600">
        Research Hub
      </a>
      <a href="/en/career/" class="px-4 py-2 border border-neutral-700 text-neutral-300 rounded text-sm hover:bg-neutral-800">
        Career Hub
      </a>
    </div>
  </section>
</BaseLayout>
