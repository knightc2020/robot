---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { splitResearchFeed } from '../../utils/research';

const researchFeed = splitResearchFeed(await getCollection('en/research'));
const latestResearch = [...researchFeed.recommended, ...researchFeed.latest].slice(0, 3);

const latestCareer = (await getCollection('en/career'))
  .filter((p) => p.data.status === 'published')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<BaseLayout title="RoboMatrix - Public-Source Robotics Research & Career Intelligence" lang="en" description="A work-in-progress platform for robotics research and career information, with public source links retained where available.">

  <!-- Hero -->
  <section class="relative py-20 md:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <div class="relative">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 border border-neutral-800 rounded-full text-xs text-neutral-500">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        Public-source robotics research and career intelligence
      </div>

      <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.1] mb-6">
        <span class="text-neutral-50">Robotics Research</span><br />
        <span class="bg-gradient-to-r from-primary-400 to-primary-600 bg-clip-text text-transparent">& Career Intelligence</span>
      </h1>

      <p class="text-lg md:text-xl text-neutral-400 max-w-2xl mb-10 leading-relaxed">
        A work-in-progress platform for tracking robotics research and career information.<br class="hidden md:block" />
        Public source links are retained where available.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/en/research/" class="group inline-flex items-center gap-2 px-6 py-3 bg-primary-700 text-white rounded-lg text-sm font-medium hover:bg-primary-600 transition-all no-underline">
          Industry Research
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="/en/career/" class="inline-flex items-center gap-2 px-6 py-3 border border-neutral-700 text-neutral-300 rounded-lg text-sm font-medium hover:bg-neutral-900 hover:border-neutral-600 transition-all no-underline">
          Career Hub
        </a>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="border-y border-neutral-800 py-8 mb-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <div class="text-lg md:text-xl font-bold text-neutral-50">Public Sources</div>
        <div class="text-xs text-neutral-500 mt-1">Links retained where available</div>
      </div>
      <div>
        <div class="text-lg md:text-xl font-bold text-neutral-50">Traceable Context</div>
        <div class="text-xs text-neutral-500 mt-1">Dates and context shown where available</div>
      </div>
      <div>
        <div class="text-lg md:text-xl font-bold text-neutral-50">Ongoing Updates</div>
        <div class="text-xs text-neutral-500 mt-1">Content reviewed progressively</div>
      </div>
      <div>
        <div class="text-lg md:text-xl font-bold text-neutral-50">Human Review</div>
        <div class="text-xs text-neutral-500 mt-1">Editorial checks before publication</div>
      </div>
    </div>
  </section>

  <!-- Two-column modules -->
  <section class="grid md:grid-cols-2 gap-6 mb-16">
    <div class="group border border-neutral-800 rounded-xl p-6 hover:border-neutral-700 transition-colors">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-lg bg-primary-900/40 border border-primary-800/50 flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-neutral-100">Industry Research</h2>
          <p class="text-xs text-neutral-500">Deep-Dive Reports & Data Matrices</p>
        </div>
      </div>
      <p class="text-sm text-neutral-400 mb-5">Robotics research updates built from publicly available papers, official pages, and other documented sources.</p>
      <div class="space-y-3">
        {latestResearch.map((post) => (
          <a href={`/en/research/${post.id.replace(/\.mdx?$/, '')}/`} class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-neutral-900/50 no-underline group/item">
            <span class="text-sm text-neutral-300 group-hover/item:text-primary-400 transition-colors truncate mr-4">{post.data.title}</span>
            <span class="text-[10px] text-neutral-600 shrink-0">{post.data.date.toISOString().slice(0, 10)}</span>
          </a>
        ))}
      </div>
      <a href="/en/research/" class="inline-flex items-center gap-1 mt-4 text-xs text-primary-400 hover:text-primary-300 no-underline">
        View all research →
      </a>
    </div>

    <div class="group border border-neutral-800 rounded-xl p-6 hover:border-neutral-700 transition-colors">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-lg bg-emerald-900/40 border border-emerald-800/50 flex items-center justify-center">
          <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-neutral-100">Career Navigation</h2>
          <p class="text-xs text-neutral-500">Skills, Salaries & Growth Paths</p>
        </div>
      </div>
      <p class="text-sm text-neutral-400 mb-5">A developing knowledge base for robotics skills, roles, and career paths. Job and research information may change over time.</p>
      <div class="space-y-3">
        {latestCareer.map((post) => (
          <a href={`/en/career/${post.id.replace(/\.mdx?$/, '')}/`} class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-neutral-900/50 no-underline group/item">
            <span class="text-sm text-neutral-300 group-hover/item:text-emerald-400 transition-colors truncate mr-4">{post.data.title}</span>
            <span class="text-[10px] text-neutral-600 shrink-0">{post.data.date.toISOString().slice(0, 10)}</span>
          </a>
        ))}
      </div>
      <a href="/en/career/" class="inline-flex items-center gap-1 mt-4 text-xs text-emerald-400 hover:text-emerald-300 no-underline">
        View all guides →
      </a>
    </div>
  </section>

  <!-- Content approach -->
  <section class="border border-neutral-800 rounded-xl p-8 mb-16 bg-neutral-900/30">
    <h2 class="text-xl font-semibold mb-6 text-neutral-100">How We Handle Content</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <div class="text-sm font-medium text-primary-400 mb-2">01 · Publicly Available Sources</div>
        <p class="text-sm text-neutral-400">We link papers and official pages where they are available.</p>
      </div>
      <div>
        <div class="text-sm font-medium text-primary-400 mb-2">02 · Review in Progress</div>
        <p class="text-sm text-neutral-400">Content is reviewed progressively as sources and context are checked.</p>
      </div>
      <div>
        <div class="text-sm font-medium text-primary-400 mb-2">03 · Changing Information</div>
        <p class="text-sm text-neutral-400">Job and research information can change over time; pages are updated as work continues.</p>
      </div>
    </div>
  </section>

</BaseLayout>
