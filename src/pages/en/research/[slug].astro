---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { isPublishableContent } from '../../../lib/content-governance';

export async function getStaticPaths() {
  const posts = (await getCollection('en/research')).filter(isPublishableContent);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout frontmatter={post.data} lang="en" slug={post.id}>
  <Content />
</ArticleLayout>
