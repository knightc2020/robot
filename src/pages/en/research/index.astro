---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { splitResearchFeed } from '../../../utils/research';

const { recommended, latest } = splitResearchFeed(await getCollection('en/research'));
const postCount = recommended.length + latest.length;
---

<BaseLayout title="Research Hub - RoboMatrix" lang="en">
  <h1 class="text-2xl font-bold mb-2">Due Diligence Research</h1>
  <p class="text-neutral-500 text-sm mb-8">Deep-dive industry reports, hardware BOM teardowns, data matrices</p>

  {postCount === 0 && (
    <p class="text-neutral-600 text-sm">No published research reports yet.</p>
  )}

  {recommended.length > 0 && (
    <section class="mb-12">
      <div class="flex items-end justify-between mb-4">
        <div>
          <p class="text-xs font-mono text-amber-400 uppercase tracking-widest mb-1">Editor's Picks</p>
          <h2 class="text-xl font-semibold text-neutral-100">Featured Research</h2>
        </div>
        <span class="text-xs text-neutral-600">Last 7 days · Technical and industry impact</span>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {recommended.map((post) => (
          <a href={`/en/research/${post.id.replace(/\.mdx?$/, '')}/`} class="block group no-underline">
            <article class="h-full p-5 border border-amber-900/60 bg-amber-950/10 rounded-xl hover:border-amber-700/70 transition-colors">
              <div class="flex items-center justify-between gap-3 mb-3 text-[11px]">
                <span class="text-amber-400">Featured paper</span>
                {post.data.importance_score !== undefined && (
                  <span class="text-neutral-500">Impact {post.data.importance_score}/100</span>
                )}
              </div>
              <h3 class="text-base font-medium text-neutral-100 group-hover:text-amber-300">{post.data.title}</h3>
              {post.data.summary && <p class="mt-3 text-sm text-neutral-400 line-clamp-3">{post.data.summary}</p>}
              {post.data.selection_reason && <p class="mt-3 text-xs text-amber-200/60">{post.data.selection_reason}</p>}
            </article>
          </a>
        ))}
      </div>
    </section>
  )}

  {latest.length > 0 && <h2 class="text-xl font-semibold text-neutral-100 mb-4">Latest Papers</h2>}
  <div class="space-y-6">
    {latest.map((post) => (
      <a href={`/en/research/${post.id.replace(/\.mdx?$/, '')}/`} class="block group no-underline">
        <article class="p-4 border border-neutral-800 rounded-lg hover:border-neutral-700 transition-colors">
          <h2 class="text-base font-medium text-neutral-100 group-hover:text-primary-400">{post.data.title}</h2>
          <div class="flex items-center gap-3 mt-2 text-xs text-neutral-500">
            <time>{post.data.date.toISOString().slice(0, 10)}</time>
            <span class="px-1.5 py-0.5 bg-neutral-800 rounded">{post.data.industry_sector}</span>
          </div>
          {post.data.summary && <p class="mt-2 text-sm text-neutral-400">{post.data.summary}</p>}
        </article>
      </a>
    ))}
  </div>
</BaseLayout>
