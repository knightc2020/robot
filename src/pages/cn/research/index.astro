---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isPublishableContent } from '../../../lib/content-governance';

const posts = (await getCollection('cn/research'))
  .filter(isPublishableContent)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="行业研究 - RoboMatrix" lang="cn">
  <h1 class="text-2xl font-bold mb-2">行业研究</h1>
  <p class="text-neutral-500 text-sm mb-8">保留公开来源和审核状态的机器人研究</p>

  {posts.length === 0 && (
    <p class="text-neutral-600 text-sm">暂无已发布的研究报告。</p>
  )}

  <div class="space-y-6">
    {posts.map((post) => (
      <a href={`/cn/research/${post.id.replace(/\.mdx?$/, '')}/`} class="block group no-underline">
        <article class="p-4 border border-neutral-800 rounded-lg hover:border-neutral-700 transition-colors">
          <h2 class="text-base font-medium text-neutral-100 group-hover:text-primary-400">{post.data.title}</h2>
          <div class="flex items-center gap-3 mt-2 text-xs text-neutral-500">
            <time>{post.data.date.toISOString().slice(0, 10)}</time>
            <span class="px-1.5 py-0.5 bg-neutral-800 rounded">{post.data.industry_sector}</span>
          </div>
          {post.data.summary && <p class="mt-2 text-sm text-neutral-400">{post.data.summary}</p>}
        </article>
      </a>
    ))}
  </div>
</BaseLayout>
