---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isPublishableContent } from '../../lib/content-governance';

const latestResearch = (await getCollection('cn/research'))
  .filter(isPublishableContent)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const latestCareer = (await getCollection('cn/career'))
  .filter(isPublishableContent)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// 前沿研究动态：只取中文 research，最新 6 篇
const latestNews = (await getCollection('cn/research'))
  .filter(isPublishableContent)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 6);
---

<BaseLayout title="RoboMatrix - 机器人产业研究与职业导航" lang="cn" description="持续跟踪机器人产业、技术与职业信息；重要结论保留公开来源和更新时间。">

  <!-- Hero -->
  <section class="relative py-20 md:py-32 overflow-hidden">
    <!-- Grid background -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <div class="relative">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 border border-neutral-800 rounded-full text-xs text-neutral-500">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        机器人产业与职业信息持续更新中
      </div>

      <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.1] mb-6">
        <span class="text-neutral-50">持续跟踪机器人产业</span><br />
        <span class="bg-gradient-to-r from-primary-400 to-primary-600 bg-clip-text text-transparent">技术与职业信息</span>
      </h1>

      <p class="text-lg md:text-xl text-neutral-400 max-w-2xl mb-10 leading-relaxed">
        研究内容尽量保留原始公开来源、发布时间和治理更新时间。<br class="hidden md:block" />
        机器人职业情报系统正在建设中。
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/cn/research/" class="group inline-flex items-center gap-2 px-6 py-3 bg-primary-700 text-white rounded-lg text-sm font-medium hover:bg-primary-600 transition-all no-underline">
          进入行业研究
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href="/cn/career/" class="inline-flex items-center gap-2 px-6 py-3 border border-neutral-700 text-neutral-300 rounded-lg text-sm font-medium hover:bg-neutral-900 hover:border-neutral-600 transition-all no-underline">
          职业导航
        </a>
        <a href="/ppt/weekly-review-2026-03-04/index.html" class="inline-flex items-center gap-2 px-6 py-3 border border-primary-700 text-primary-400 rounded-lg text-sm font-medium hover:bg-primary-900/20 hover:border-primary-600 transition-all no-underline">
          📊 本周研发回顾 PPT
        </a>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="border-y border-neutral-800 py-8 mb-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <div class="text-lg md:text-xl font-bold text-neutral-50">产业研究</div>
        <div class="text-xs text-neutral-500 mt-1">持续跟踪公开信息</div>
      </div>
      <div>
        <div class="text-lg md:text-xl font-bold text-neutral-50">职业导航</div>
        <div class="text-xs text-neutral-500 mt-1">情报系统建设中</div>
      </div>
      <div>
        <div class="text-lg md:text-xl font-bold text-neutral-50">来源记录</div>
        <div class="text-xs text-neutral-500 mt-1">保留原始公开链接</div>
      </div>
      <div>
        <div class="text-lg md:text-xl font-bold text-neutral-50">状态治理</div>
        <div class="text-xs text-neutral-500 mt-1">明确审核与更新时间</div>
      </div>
    </div>
  </section>

  <!-- Two-column modules -->
  <section class="grid md:grid-cols-2 gap-6 mb-16">
    <!-- Research card -->
    <div class="group border border-neutral-800 rounded-xl p-6 hover:border-neutral-700 transition-colors">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-lg bg-primary-900/40 border border-primary-800/50 flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-neutral-100">行业研究</h2>
          <p class="text-xs text-neutral-500">Due Diligence Hub</p>
        </div>
      </div>
      <p class="text-sm text-neutral-400 mb-5">整理机器人研究动态，并为公开内容保留可定位的原始来源与审核状态。</p>
      <div class="space-y-3">
        {latestResearch.map((post) => (
          <a href={`/cn/research/${post.id.replace(/\.mdx?$/, '')}/`} class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-neutral-900/50 no-underline group/item">
            <span class="text-sm text-neutral-300 group-hover/item:text-primary-400 transition-colors truncate mr-4">{post.data.title}</span>
            <span class="text-[10px] text-neutral-600 shrink-0">{post.data.date.toISOString().slice(0, 10)}</span>
          </a>
        ))}
      </div>
      <a href="/cn/research/" class="inline-flex items-center gap-1 mt-4 text-xs text-primary-400 hover:text-primary-300 no-underline">
        查看全部研究 →
      </a>
    </div>

    <!-- Career card -->
    <div class="group border border-neutral-800 rounded-xl p-6 hover:border-neutral-700 transition-colors">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-lg bg-emerald-900/40 border border-emerald-800/50 flex items-center justify-center">
          <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-neutral-100">职业导航</h2>
          <p class="text-xs text-neutral-500">Career Mentorship Hub</p>
        </div>
      </div>
      <p class="text-sm text-neutral-400 mb-5">机器人职业情报系统正在建设中，当前不发布无来源的薪资或问卷结论。</p>
      <div class="space-y-3">
        {latestCareer.map((post) => (
          <a href={`/cn/career/${post.id.replace(/\.mdx?$/, '')}/`} class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-neutral-900/50 no-underline group/item">
            <span class="text-sm text-neutral-300 group-hover/item:text-emerald-400 transition-colors truncate mr-4">{post.data.title}</span>
            <span class="text-[10px] text-neutral-600 shrink-0">{post.data.date.toISOString().slice(0, 10)}</span>
          </a>
        ))}
      </div>
      <a href="/cn/career/" class="inline-flex items-center gap-1 mt-4 text-xs text-emerald-400 hover:text-emerald-300 no-underline">
        查看全部指南 →
      </a>
    </div>
  </section>

  <!-- 前沿研究动态 -->
  <section class="mb-16">
    <div class="flex items-end justify-between mb-6">
      <div>
        <p class="text-xs font-mono text-violet-400 uppercase tracking-widest mb-1">Research Feed</p>
        <h2 class="text-xl font-semibold text-neutral-100">前沿研究动态</h2>
        <p class="text-xs text-neutral-500 mt-1">最新论文解读 · AI &amp; 机器人领域前沿进展</p>
      </div>
      <a href="/research-news/" class="text-xs text-violet-400 hover:text-violet-300 no-underline shrink-0">
        查看全部 →
      </a>
    </div>

    {latestNews.length === 0 ? (
      <div class="border border-dashed border-neutral-800 rounded-xl py-12 text-center text-neutral-600 text-sm">
        暂无已发布的论文解读
      </div>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {latestNews.map((post) => {
          const slug = `cn/${post.id.replace(/\.mdx?$/, '')}`;
          const date = new Date(post.data.date).toLocaleDateString('zh-CN', {
            month: 'short', day: 'numeric',
          });
          return (
            <a
              href={`/research-news/${slug}/`}
              class="group block no-underline rounded-xl border border-neutral-800 bg-neutral-900/40 hover:border-violet-800/60 hover:bg-violet-950/10 transition-all duration-200 p-4"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] px-1.5 py-0.5 bg-neutral-800 text-neutral-500 rounded">
                  {post.data.industry_sector}
                </span>
                <time class="text-[11px] text-neutral-600">{date}</time>
              </div>
              <h3 class="text-sm font-medium text-neutral-200 group-hover:text-violet-300 transition-colors leading-snug mb-2 line-clamp-2">
                {post.data.title}
              </h3>
              {post.data.summary && (
                <p class="text-xs text-neutral-500 line-clamp-2">{post.data.summary}</p>
              )}
            </a>
          );
        })}
      </div>
    )}
  </section>

  <!-- Content governance -->
  <section class="border border-neutral-800 rounded-xl p-8 mb-16 bg-neutral-900/30">
    <h2 class="text-xl font-semibold mb-6 text-neutral-100">内容治理原则</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <div class="text-sm font-medium text-primary-400 mb-2">01 · 公开来源</div>
        <p class="text-sm text-neutral-400">重要研究结论保留论文或官方页面链接；缺少来源时不展示虚假来源标签。</p>
      </div>
      <div>
        <div class="text-sm font-medium text-primary-400 mb-2">02 · 状态明确</div>
        <p class="text-sm text-neutral-400">仅显式发布的内容生成公开页面，并如实标注当前审核状态。</p>
      </div>
      <div>
        <div class="text-sm font-medium text-primary-400 mb-2">03 · 时间可追踪</div>
        <p class="text-sm text-neutral-400">内容日期来自文章元数据；构建时间不冒充内容更新时间。</p>
      </div>
    </div>
  </section>

</BaseLayout>
