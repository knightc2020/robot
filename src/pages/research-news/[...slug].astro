---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { isPublishableContent } from '../../lib/content-governance';

export async function getStaticPaths() {
  const cnPosts = (await getCollection('cn/research')).filter(isPublishableContent);
  const enPosts = (await getCollection('en/research')).filter(isPublishableContent);

  return [
    ...cnPosts.map((post) => ({
      params: { slug: `cn/${post.id.replace(/\.mdx?$/, '')}` },
      props: { post, lang: 'cn' as const },
    })),
    ...enPosts.map((post) => ({
      params: { slug: `en/${post.id.replace(/\.mdx?$/, '')}` },
      props: { post, lang: 'en' as const },
    })),
  ];
}

const { post, lang } = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout frontmatter={post.data} lang={lang} slug={post.id}>
  <Content />
</ArticleLayout>
