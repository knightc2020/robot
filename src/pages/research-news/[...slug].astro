---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

const { slug } = Astro.params;
const segments = slug?.split('/') ?? [];
const lang = segments[0] as 'en' | 'cn';
const entryId = segments.slice(1).join('/');

if (!lang || !entryId || !['en', 'cn'].includes(lang)) {
  return Astro.redirect('/404');
}

const collectionName = `${lang}/research` as 'en/research' | 'cn/research';
const post = await getEntry(collectionName, entryId);

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);
---

<ArticleLayout frontmatter={post.data} lang={lang} slug={post.id}>
  <Content />
</ArticleLayout>
