---
import BaseLayout from './BaseLayout.astro';
import FeedbackFlywheel from '../components/FeedbackFlywheel.astro';
import ContentMetadata from '../components/ContentMetadata.astro';

interface Props {
  frontmatter: {
    title: string;
    date: Date | string;
    publishedAt?: Date | string;
    updatedAt?: Date | string;
    author?: string;
    tags?: string[];
    industry_sector?: string;
    reviewStatus?: string;
    sourceType?: string;
    sourceUrls?: string[];
    summary?: string;
  };
  lang?: 'en' | 'cn';
  slug?: string;
}

const { frontmatter, lang = 'cn', slug = '' } = Astro.props;
---

<BaseLayout title={frontmatter.title} lang={lang}>
  <article>
    <header class="mb-8 pb-6 border-b border-neutral-800">
      <h1 class="text-2xl md:text-3xl mb-3">{frontmatter.title}</h1>
      <ContentMetadata metadata={frontmatter} lang={lang} />
      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {frontmatter.tags.map((tag: string) => (
            <span class="px-2 py-0.5 bg-neutral-800 text-neutral-400 text-[11px] rounded">
              {tag}
            </span>
          ))}
        </div>
      )}
      {frontmatter.summary && (
        <p class="mt-4 text-sm text-neutral-400 italic">{frontmatter.summary}</p>
      )}
    </header>

    <div class="prose-data">
      <slot />
    </div>

    <FeedbackFlywheel lang={lang} articleSlug={slug} />
  </article>
</BaseLayout>
