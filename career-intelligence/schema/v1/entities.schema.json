{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotcareer.cloud/schemas/career-intelligence/v1/entities.schema.json",
  "title": "Career Intelligence Entity Contracts v1",
  "description": "Logical contracts for the seven Phase 2 entities. JSON-valued SQLite columns are represented as decoded arrays or objects at processing boundaries.",
  "oneOf": [
    { "$ref": "#/$defs/company" },
    { "$ref": "#/$defs/career_source" },
    { "$ref": "#/$defs/job_posting" },
    { "$ref": "#/$defs/skill" },
    { "$ref": "#/$defs/job_skill_relation" },
    { "$ref": "#/$defs/job_change" },
    { "$ref": "#/$defs/project_template" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullable_timestamp": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "nullable_string": { "type": ["string", "null"] },
    "https_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "nullable_https_url": { "oneOf": [{ "$ref": "#/$defs/https_url" }, { "type": "null" }] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullable_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "review_status": { "enum": ["pending", "approved", "rejected"] },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "schema_version", "legal_name", "display_name", "aliases", "regions", "lifecycle_status", "verification_status", "created_at", "updated_at"],
      "properties": {
        "company_id": { "$ref": "#/$defs/id" },
        "schema_version": { "const": 1 },
        "legal_name": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "country_code": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "regions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "official_website_url": { "$ref": "#/$defs/nullable_https_url" },
        "official_career_url": { "$ref": "#/$defs/nullable_https_url" },
        "ats_type": { "$ref": "#/$defs/nullable_string" },
        "lifecycle_status": { "enum": ["candidate", "verified", "active", "paused", "retired"] },
        "verification_status": { "enum": ["unverified", "pending", "verified", "rejected"] },
        "verified_at": { "$ref": "#/$defs/nullable_timestamp" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "career_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "schema_version", "company_id", "source_url", "source_type", "collection_method", "scope", "terms_review_status", "robots_review_status", "enabled", "lifecycle_status", "health_status", "owner", "created_at", "updated_at"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "schema_version": { "const": 1 },
        "company_id": { "$ref": "#/$defs/id" },
        "source_url": { "$ref": "#/$defs/https_url" },
        "source_type": { "enum": ["official_career_page", "official_ats_api", "official_ats_feed", "approved_official_export"] },
        "collection_method": { "type": "string", "minLength": 1 },
        "scope": { "type": "object" },
        "schedule_hint": { "$ref": "#/$defs/nullable_string" },
        "terms_review_status": { "enum": ["not_reviewed", "approved", "restricted", "blocked"] },
        "terms_reviewed_at": { "$ref": "#/$defs/nullable_timestamp" },
        "robots_review_status": { "enum": ["not_reviewed", "allowed", "restricted", "blocked", "not_applicable"] },
        "enabled": { "type": "boolean" },
        "lifecycle_status": { "enum": ["candidate", "verified", "enabled", "degraded", "paused", "retired"] },
        "health_status": { "enum": ["never_run", "healthy", "degraded", "blocked", "paused", "retired"] },
        "last_collected_at": { "$ref": "#/$defs/nullable_timestamp" },
        "last_source_updated_at": { "$ref": "#/$defs/nullable_timestamp" },
        "last_http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "last_retrieval_result": { "type": ["string", "null"], "enum": [null, "success", "not_modified", "empty", "rate_limited", "access_denied", "network_error", "invalid_response"] },
        "owner": { "type": "string", "minLength": 1 },
        "verified_at": { "$ref": "#/$defs/nullable_timestamp" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "job_posting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "schema_version", "company_id", "source_id", "source_native_id", "source_url", "source_title", "first_collected_at", "last_collected_at", "lifecycle_status", "content_hash", "raw_snapshot_ref", "parser_version", "extraction_metadata", "quality_status", "review_status", "publication_status", "created_at", "updated_at"],
      "properties": {
        "job_id": { "$ref": "#/$defs/id" },
        "schema_version": { "const": 1 },
        "company_id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "source_native_id": { "type": "string", "minLength": 1 },
        "source_url": { "$ref": "#/$defs/https_url" },
        "source_title": { "type": "string", "minLength": 1 },
        "normalized_title": { "$ref": "#/$defs/nullable_string" },
        "description_text": { "$ref": "#/$defs/nullable_string" },
        "location_text": { "$ref": "#/$defs/nullable_string" },
        "country_code": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "region": { "$ref": "#/$defs/nullable_string" },
        "employment_type": { "type": ["string", "null"], "enum": [null, "full_time", "part_time", "contract", "temporary", "internship", "apprenticeship", "other", "unknown"] },
        "job_family_key": { "$ref": "#/$defs/nullable_string" },
        "source_posted_at": { "$ref": "#/$defs/nullable_timestamp" },
        "source_updated_at": { "$ref": "#/$defs/nullable_timestamp" },
        "first_collected_at": { "$ref": "#/$defs/timestamp" },
        "last_collected_at": { "$ref": "#/$defs/timestamp" },
        "lifecycle_status": { "enum": ["observed", "active", "changed", "missing", "closed", "quarantined"] },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "raw_snapshot_ref": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 },
        "extraction_metadata": { "type": "object" },
        "quality_status": { "enum": ["raw", "parsed", "validation_failed", "review_pending", "approved", "publishable", "published"] },
        "review_status": { "$ref": "#/$defs/review_status" },
        "reviewed_by": { "$ref": "#/$defs/nullable_string" },
        "reviewed_at": { "$ref": "#/$defs/nullable_timestamp" },
        "publication_status": { "enum": ["blocked", "review_pending", "eligible", "published"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "schema_version", "canonical_name", "aliases", "category", "definition", "evidence_expectations", "lifecycle_status", "taxonomy_version", "review_status", "created_at", "updated_at"],
      "properties": {
        "skill_id": { "$ref": "#/$defs/id" },
        "schema_version": { "const": 1 },
        "canonical_name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "category": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "evidence_expectations": { "type": "string", "minLength": 1 },
        "lifecycle_status": { "enum": ["draft", "review", "active", "deprecated"] },
        "taxonomy_version": { "type": "integer", "minimum": 1 },
        "review_status": { "$ref": "#/$defs/review_status" },
        "reviewed_by": { "$ref": "#/$defs/nullable_string" },
        "reviewed_at": { "$ref": "#/$defs/nullable_timestamp" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "job_skill_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "skill_id", "schema_version", "requirement_strength", "evidence_excerpt", "extraction_method", "extraction_version", "review_status", "first_observed_at", "last_observed_at"],
      "properties": {
        "job_id": { "$ref": "#/$defs/id" },
        "skill_id": { "$ref": "#/$defs/id" },
        "schema_version": { "const": 1 },
        "requirement_strength": { "enum": ["mentioned", "preferred", "required", "core"] },
        "evidence_excerpt": { "type": "string", "minLength": 1 },
        "parser_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "extraction_method": { "enum": ["deterministic", "model_assisted", "manual"] },
        "extraction_version": { "type": "string", "minLength": 1 },
        "review_status": { "$ref": "#/$defs/review_status" },
        "reviewed_by": { "$ref": "#/$defs/nullable_string" },
        "reviewed_at": { "$ref": "#/$defs/nullable_timestamp" },
        "first_observed_at": { "$ref": "#/$defs/timestamp" },
        "last_observed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "job_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "schema_version", "job_id", "source_id", "change_type", "changed_fields", "observed_at", "source_url", "collected_at", "raw_snapshot_ref", "retrieval_result", "created_at"],
      "properties": {
        "change_id": { "$ref": "#/$defs/id" },
        "schema_version": { "const": 1 },
        "job_id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "change_type": { "enum": ["first_observed", "content_changed", "status_changed", "source_updated", "location_changed", "missing", "closed", "reopened", "quarantined"] },
        "previous_content_hash": { "$ref": "#/$defs/nullable_sha256" },
        "new_content_hash": { "$ref": "#/$defs/nullable_sha256" },
        "changed_fields": { "type": "object" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "source_url": { "$ref": "#/$defs/https_url" },
        "collected_at": { "$ref": "#/$defs/timestamp" },
        "raw_snapshot_ref": { "type": "string", "minLength": 1 },
        "retrieval_result": { "enum": ["success", "not_modified", "empty", "rate_limited", "access_denied", "network_error", "invalid_response"] },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "project_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_template_id", "schema_version", "slug", "title", "summary", "difficulty", "deliverables", "acceptance_evidence", "lifecycle_status", "review_status", "created_at", "updated_at"],
      "properties": {
        "project_template_id": { "$ref": "#/$defs/id" },
        "schema_version": { "const": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": ["introductory", "intermediate", "advanced"] },
        "estimated_effort_hours": { "type": ["integer", "null"], "minimum": 1 },
        "prerequisites_text": { "$ref": "#/$defs/nullable_string" },
        "deliverables": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "acceptance_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "safety_notes": { "$ref": "#/$defs/nullable_string" },
        "license_notes": { "$ref": "#/$defs/nullable_string" },
        "lifecycle_status": { "enum": ["draft", "review", "approved", "archived"] },
        "review_status": { "$ref": "#/$defs/review_status" },
        "reviewed_by": { "$ref": "#/$defs/nullable_string" },
        "reviewed_at": { "$ref": "#/$defs/nullable_timestamp" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
